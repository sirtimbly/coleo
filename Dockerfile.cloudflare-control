# Coleo control-plane runtime for Cloudflare Containers.
FROM oven/bun:1.3-debian AS builder

WORKDIR /app
COPY package.json bun.lock ./
COPY src/web/package.json ./src/web/package.json
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM debian:bookworm-slim AS awscli
RUN apt-get update && apt-get install -y ca-certificates curl unzip \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /var/lib/apt/lists/* /tmp/aws /tmp/awscliv2.zip

FROM qdrant/qdrant:v1.18.0 AS qdrant

FROM oven/bun:1.3-debian

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    libunwind8 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=awscli /usr/local/aws-cli /usr/local/aws-cli
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws \
    && aws --version

COPY --from=qdrant /qdrant/qdrant /usr/local/bin/qdrant
RUN qdrant --version

RUN useradd -m -s /bin/bash coleo
WORKDIR /home/coleo/coleo
COPY --from=builder /app /home/coleo/coleo
RUN mkdir -p /home/coleo/.coleo \
    && chown -R coleo:coleo /home/coleo \
    && printf '#!/bin/sh\nexec bun /home/coleo/coleo/src/cli/index.ts "$@"\n' > /usr/local/bin/coleo \
    && chmod +x /usr/local/bin/coleo

COPY --chown=coleo:coleo docker/cloudflare-control-entrypoint.sh /home/coleo/control-entrypoint.sh
RUN chmod +x /home/coleo/control-entrypoint.sh

USER coleo
ENV COLEO_DIR=/home/coleo/.coleo \
    COLEO_QDRANT_URL=http://127.0.0.1:6333 \
    COLEO_REMOTE_ARMS_ONLY=1 \
    COLEO_REMOTE_WORKDIR=/home/coleo/runtime/workspace
EXPOSE 3000
ENTRYPOINT ["/home/coleo/control-entrypoint.sh"]

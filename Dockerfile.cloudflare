# Coleo tenant runtime for Cloudflare Containers.
FROM oven/bun:1.3.14-debian AS builder

WORKDIR /app

COPY package.json bun.lock ./
COPY clients/web/package.json ./clients/web/package.json
RUN bun install --frozen-lockfile

COPY . .
RUN bun run build:with-web

FROM oven/bun:1.3.14-debian

RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir awscli \
    && ln -s /opt/venv/bin/aws /usr/local/bin/aws

RUN useradd -m -s /bin/bash coleo

WORKDIR /home/coleo/coleo
COPY --from=builder /app /home/coleo/coleo
RUN chown -R coleo:coleo /home/coleo/coleo \
    && printf '#!/bin/sh\nexec bun /home/coleo/coleo/server/src/cli/index.ts "$@"\n' > /usr/local/bin/coleo \
    && chmod +x /usr/local/bin/coleo

COPY --chown=coleo:coleo docker/cloudflare-entrypoint.sh /home/coleo/cloudflare-entrypoint.sh
COPY docker/coleo-web /usr/local/bin/coleo-web
RUN chmod +x /home/coleo/cloudflare-entrypoint.sh /usr/local/bin/coleo-web

USER coleo
ENV COLEO_DIR=/home/coleo/.coleo

EXPOSE 3000
ENTRYPOINT ["/home/coleo/cloudflare-entrypoint.sh"]

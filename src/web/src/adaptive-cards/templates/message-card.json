{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${from}",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${subject}",
      "size": "Medium",
      "weight": "Bolder",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "${preview}",
      "wrap": true,
      "maxLines": 6
    },
    {
      "type": "TextBlock",
      "text": "${timestampLabel}",
      "size": "Small",
      "isSubtle": true
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Open conversation",
      "verb": "message.open",
      "data": {
        "actionId": "open-message"
      }
    },
    {
      "type": "Action.Execute",
      "$when": "${canArchive}",
      "title": "Archive",
      "verb": "message.archive",
      "data": {
        "actionId": "archive-message"
      },
      "mode": "secondary"
    }
  ]
}

{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"heroui-react": {
			"type": "local",
			"command": ["npx", "-y", "@heroui/react-mcp@latest"],
			"enabled": true
		},
		"coleo": {
			"type": "local",
			"command": [
				"bun",
				"run",
				"./src/cli/index.ts",
				"mcp",
				"serve"
			],
			"environment": {
				"COLEO_ARM_ID": "opencode-test",
				"COLEO_DIR": "./.coleo"
			},
			"enabled": true
		}
	}
}

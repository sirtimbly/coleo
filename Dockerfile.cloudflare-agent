# Long-lived Coleo arm-agent runtime for Cloudflare Containers.
FROM oven/bun:1.3.6-debian AS builder

WORKDIR /app
COPY package.json bun.lock ./
COPY src/web/package.json ./src/web/package.json
RUN bun install --frozen-lockfile --production
COPY src ./src
RUN mkdir -p dist \
    && bun build src/agent/cloudflare-entry.ts \
      --target=bun \
      --outfile=dist/cloudflare-agent.js \
    && mkdir -p dist/node_modules/bun-pty \
    && cp -aL node_modules/bun-pty/. dist/node_modules/bun-pty/

FROM debian:bookworm-slim AS awscli
RUN apt-get update && apt-get install -y ca-certificates curl unzip \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /var/lib/apt/lists/* /tmp/aws /tmp/awscliv2.zip

FROM oven/bun:1.3.6-debian

ARG NATS_VERSION=2.12.3
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    openssh-client \
    procps \
    ripgrep \
    tar \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=awscli /usr/local/aws-cli /usr/local/aws-cli
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws \
    && aws --version

RUN curl -fsSL \
      "https://github.com/nats-io/nats-server/releases/download/v${NATS_VERSION}/nats-server-v${NATS_VERSION}-linux-amd64.tar.gz" \
      -o /tmp/nats-server.tar.gz \
    && tar -xzf /tmp/nats-server.tar.gz -C /tmp \
    && install -m 0755 "/tmp/nats-server-v${NATS_VERSION}-linux-amd64/nats-server" /usr/local/bin/nats-server \
    && rm -rf /tmp/nats-server*

ENV BUN_INSTALL=/usr/local
# Upgrade OpenCode deliberately here. This version participates in the Arm Host
# content tag through this Dockerfile; do not replace it with latest or a build arg.
RUN bun install --global "opencode-ai@1.17.19" && opencode --version

RUN useradd -m -s /bin/bash coleo
WORKDIR /home/coleo
COPY --from=builder /app/dist/cloudflare-agent.js /home/coleo/cloudflare-agent.js
COPY --from=builder /app/dist/node_modules /home/coleo/node_modules
RUN chown -R coleo:coleo /home/coleo \
	&& printf '#!/bin/sh\nexec bun /home/coleo/cloudflare-agent.js "$@"\n' > /usr/local/bin/coleo-agent \
	&& chmod +x /usr/local/bin/coleo-agent

COPY --chown=coleo:coleo docker/cloudflare-agent-entrypoint.sh /home/coleo/agent-entrypoint.sh
RUN chmod +x /home/coleo/agent-entrypoint.sh

USER coleo
ENV COLEO_DIR=/home/coleo/runtime/coleo
ENV COLEO_WORKDIR=/home/coleo/runtime/workspace
ENV COLEO_CLI_ENTRYPOINT=/home/coleo/cloudflare-agent.js
EXPOSE 8222 9222
ENTRYPOINT ["/home/coleo/agent-entrypoint.sh"]

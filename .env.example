# Coleo Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ===========================================
# API Keys (required for AI agents)
# ===========================================

COLEO_API_KEY=dev-ifbva7un

# Anthropic API key for Claude-based agents
ANTHROPIC_API_KEY=

# OpenAI API key (optional, for GPT-based agents)
OPENAI_API_KEY=

# Qdrant URL for semantic/vector search
# Local dev: http://localhost:6333
# Docker Compose server container: http://qdrant:6333
COLEO_QDRANT_URL=http://localhost:6333

# ===========================================
# Docker Configuration
# ===========================================

# Path to your projects directory (mounted in container)
# Default: ./projects
PROJECTS_DIR=~/projects

# Path to SSH keys for git operations
# Default: ~/.ssh
SSH_KEYS_DIR=~/.ssh

# ===========================================
# Model Selection
# ===========================================

# Preferred models for arms (comma-separated provider/model pairs)
# Arms will randomly select from this list for model diversity
# Format: provider/model,provider/model,...
# COLEO_PREFERRED_MODELS=anthropic/claude-sonnet-4-20250514,openai/gpt-4o,opencode-zen/o4-mini

# ===========================================
# Gitea Configuration (optional)
# ===========================================

# Gitea admin credentials (set on first run)
# GITEA_ADMIN_USER=coleo
# GITEA_ADMIN_PASSWORD=changeme
# GITEA_ADMIN_EMAIL=coleo@localhost

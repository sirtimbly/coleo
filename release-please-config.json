{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "package-name": "coleo",
      "release-type": "node",
      "changelog-type": "github",
      "extra-files": [
        { "type": "json", "path": "clients/web/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "pyproject.toml", "jsonpath": "$.project.version" },
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name=='coleo-inbox')].version" }
      ]
    }
  }
}

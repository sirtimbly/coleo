# --- Core app ---
# Keep loopback for local-only use.
# Set to 0.0.0.0 when you want LAN / Tailscale / VPN clients to reach the stack directly.
COLEO_BIND_HOST=127.0.0.1
COLEO_API_PORT=8080
COLEO_WEB_PORT=80
# Local default. On a home server, set this to your private hostname or Tailscale/MagicDNS URL.
COLEO_PUBLIC_ORIGIN=http://localhost
COLEO_DB_PATH=/home/coleo/.coleo/db/coleo.db

# Use `deploy/self-host/bin/bootstrap-host.sh` to generate these secrets.
COLEO_BOOTSTRAP_TOKEN=replace-with-generated-token
COLEO_API_KEY=replace-with-generated-api-key

# Optional AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenCode provider key used by headless opencode-api arms.
OPENCODE_API_KEY=
# Optional git provider token for private repository clones/API operations.
GITHUB_TOKEN=

# --- Hosted arm workspace ---
# Optional repository cloned into /home/coleo/projects/app for the OpenCode arm agent.
COLEO_GIT_REPO_URL=
# Optional branch, tag, or commit to check out after clone.
COLEO_GIT_REF=
# Set to 1 to `git pull --ff-only` an existing checkout at container startup.
COLEO_GIT_PULL_ON_START=0
# Maximum concurrent arms managed by the hosted OpenCode arm agent.
COLEO_AGENT_MAX_ARMS=10

# --- NATS/Qdrant ---
COLEO_NATS_URL=nats://nats:4222
COLEO_QDRANT_URL=http://qdrant:6333

# --- Optional edge overlay: Traefik / ACME ---
COLEO_DOMAIN=coleo.example.com
ACME_EMAIL=ops@example.com

# --- Optional edge overlay: passkey-capable auth portal (Authelia) ---
AUTH_DOMAIN=auth.example.com
AUTH_JWT_SECRET=replace-with-generated-value
AUTH_SESSION_SECRET=replace-with-generated-value
AUTH_STORAGE_ENCRYPTION_KEY=replace-with-generated-value
AUTH_HMAC_SECRET=replace-with-generated-value
AUTH_WEBAUTHN_RP_ID=auth.example.com

# Password hash is required by Authelia for bootstrap admin recovery.
# Generate with: docker run --rm authelia/authelia:latest authelia crypto hash generate argon2 --password 'change-me'
AUTH_ADMIN_PASSWORD_HASH=
AUTH_ADMIN_EMAIL=admin@example.com

# --- Optional edge overlay: enable Tailscale ingress profile ---
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=coleo-host
